# ════════════════════════════════════════════════════════════════════════════
# Zetora Environment Configuration
# ════════════════════════════════════════════════════════════════════════════
# Copy this file to `.env` and fill in your values.
# All variables are optional unless marked [REQUIRED].
# Secrets are never logged — they appear as [SET]/[UNSET] in startup output.
# ════════════════════════════════════════════════════════════════════════════

# ─── Server ────────────────────────────────────────────────────────────────
# Port the HTTP server listens on.
ZETORA_PORT=4173

# Bind address. Use 127.0.0.1 for local-only (default, recommended).
# To expose on all interfaces, set ZETORA_HOST=0.0.0.0 AND ZETORA_ALLOW_REMOTE=1.
ZETORA_HOST=127.0.0.1

# Acknowledge the risk of binding to 0.0.0.0. Has no effect unless
# ZETORA_HOST=0.0.0.0. When true, the server will bind to all interfaces
# and anyone on the network can access the agent's file/write/command tools.
ZETORA_ALLOW_REMOTE=0

# Path to the workspace directory the agent operates in.
# Absolute paths are recommended in production.
ZETORA_WORKSPACE=./workspace

# Path to the data directory (sessions, approvals, audit log, MCP config).
ZETORA_DATA=./.zetora

# Log level: debug | info | warn | error
ZETORA_LOG_LEVEL=info

# ─── Security ──────────────────────────────────────────────────────────────
# Rate limiting: max requests per window per IP.
ZETORA_RATE_LIMIT_MAX=200

# Rate limiting: window size in milliseconds.
ZETORA_RATE_LIMIT_WINDOW=60000

# Audit log rotation: max bytes per file before rotation (default 10MB).
ZETORA_AUDIT_MAX_BYTES=10485760

# Audit log rotation: max number of rotated files to keep.
ZETORA_AUDIT_MAX_FILES=5

# Session signing secret. Generate with: openssl rand -hex 32
# If unset, a random ephemeral secret is generated at startup (sessions
# are lost on restart). Set this in production for durable sessions.
ZETORA_SESSION_SECRET=

# ─── Provider API Keys ─────────────────────────────────────────────────────
# All provider keys are optional. Set only the ones you use.
# The default provider is "demo" (offline simulation) when no keys are set.

# OpenAI (gpt-5-mini, gpt-4o, etc.)
OPENAI_API_KEY=

# Anthropic (claude-sonnet-4-5, claude-opus-4-1, etc.)
ANTHROPIC_API_KEY=

# Google (gemini-2.5-flash, gemini-2.5-pro, etc.)
GOOGLE_API_KEY=

# OpenRouter (access to many models via one API)
OPENROUTER_API_KEY=

# Custom OpenAI-compatible provider (e.g. Azure, local vLLM, LM Studio)
CUSTOM_API_KEY=
CUSTOM_BASE_URL=

# ─── Provider Defaults ─────────────────────────────────────────────────────
# Default provider to use when none is specified in a chat request.
# Options: demo | openai | anthropic | google | openrouter | ollama | custom
ZETORA_PROVIDER=demo

# Default model for the chosen provider. If unset, each provider's
# defaultModel is used (e.g. gpt-5-mini for OpenAI).
ZETORA_MODEL=

# ─── Desktop / Electron ────────────────────────────────────────────────────
# Set to 1 when running under Electron (enables desktop-specific behavior).
ZETORA_DESKTOP=0

# ─── Node.js Environment ───────────────────────────────────────────────────
# development | production | test
NODE_ENV=development
