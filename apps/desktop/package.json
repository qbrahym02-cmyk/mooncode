{
  "name": "@mooncode/desktop",
  "version": "4.2.2",
  "private": true,
  "description": "Moon Code desktop app — local-first agentic workspace for code and design",
  "author": {
    "name": "Brahim",
    "email": "qbrahym02-cmyk@users.noreply.github.com"
  },
  "homepage": "https://github.com/qbrahym02-cmyk/mooncode",
  "main": "app/src/main.cjs",
  "scripts": {
    "start": "electron .",
    "start:dev": "cross-env MOONCODE_DESKTOP=1 electron .",
    "build:prepare": "node prepare.mjs",
    "package": "node prepare.mjs && electron-builder",
    "package:all": "node prepare.mjs && electron-builder -mwl",
    "package:mac": "node prepare.mjs && electron-builder --mac",
    "package:win": "node prepare.mjs && electron-builder --win",
    "package:linux": "node prepare.mjs && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "cross-env": "^7.0.3"
  },
  "build": {
    "appId": "studio.mooncode.app",
    "productName": "Moon Code",
    "copyright": "Copyright © 2026 Brahim",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "app": "app",
      "output": "dist",
      "buildResources": "build"
    },
    "asar": false,
    "files": [
      "src/**/*",
      "web/**/*",
      "server/**/*",
      "tui/**/*",
      "cli/**/*",
      "packages/**/*",
      "docs/**/*",
      "package.json",
      "brand.json",
      ".env.example"
    ],
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "minimumSystemVersion": "10.13"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.png",
      "signtoolOptions": null,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Moon Code"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "Brahim <qbrahym02-cmyk@users.noreply.github.com>",
      "vendor": "Moon Code",
      "synopsis": "Local-first agentic workspace for code and design",
      "description": "Moon Code is a local-first agentic workspace for code and design."
    }
  }
}
