# ════════════════════════════════════════════════════════════════════════════
# Moon Code .gitignore
# ════════════════════════════════════════════════════════════════════════════

# ─── Secrets & Environment ────────────────────────────────────────────────
# NEVER commit .env — it contains API keys and session secrets.
.env
.env.local
.env.*.local
.env.production
.env.staging

# ─── Runtime Data ──────────────────────────────────────────────────────────
# Moon Code's data directory (sessions, approvals, audit log, MCP config, uploads).
.mooncode/

# Moon Code's worktrees (created by the `worktree` tool).
.mooncode-worktrees/

# The demo workspace — users replace this with their own project.
# We keep the workspace/ directory in git for the demo, but ignore its
# runtime-generated files.
workspace/*.tmp
workspace/test-*.txt

# ─── Node.js ───────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.pnpm-store/

# ─── Build Artifacts ───────────────────────────────────────────────────────
dist/
build/
out/
target/
*.tsbuildinfo

# ─── Electron / Desktop ────────────────────────────────────────────────────
apps/desktop/dist/
apps/desktop/out/
apps/desktop/node_modules/
release/
*.dmg
*.exe
*.AppImage
*.deb
*.snap
release-builds/

# ─── Testing & Coverage ────────────────────────────────────────────────────
coverage/
.nyc_output/
test-results/
*.lcov

# ─── IDE & Editor ──────────────────────────────────────────────────────────
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ─── OS ────────────────────────────────────────────────────────────────────
.DS_Store
.Trash-*
ehthumbs.db
*.lnk

# ─── Logs ──────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ─── Docker ────────────────────────────────────────────────────────────────
# Don't commit docker volumes.
docker/data/
docker/workspace/

# ─── Temporary Files ───────────────────────────────────────────────────────
*.tmp
*.bak
*.cache
.tmp/
tmp/

# ─── Cryptographic Keys ────────────────────────────────────────────────────
# Plugin signing keys (generated by PluginSigner).
*.key
*.pem
!docs/**/*.pem

# ─── Package Manager Lockfiles ─────────────────────────────────────────────
# Keep package-lock.json (npm) but ignore others if you switch package managers.
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
